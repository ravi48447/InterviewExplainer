# ─── Backend API ─────────────────────────────────────────────────────────────
# URL of the Spring Boot backend (no trailing slash)
NEXT_PUBLIC_API_URL=http://localhost:8080

# ─── Site ────────────────────────────────────────────────────────────────────
# Public-facing canonical URL (used for sitemap, OG tags, canonical links)
NEXT_PUBLIC_SITE_URL=https://interviewexplainer.com

# ─── Analytics ───────────────────────────────────────────────────────────────
# Plausible Analytics domain (set to your registered Plausible domain)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=interviewexplainer.com

# ─── Newsletter / Email Capture ───────────────────────────────────────────────
# API key for Resend (https://resend.com) — used for welcome emails & newsletter
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# From address for transactional emails
RESEND_FROM_EMAIL=hello@interviewexplainer.com

# ─── Environment ─────────────────────────────────────────────────────────────
NODE_ENV=development
