{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://interviewexplainer.dev/schemas/complete-qa.schema.json",
  "title": "complete-qa",
  "description": "Canonical question contract for complete-qa.json. The repository intentionally supports both a top-level question array and metadata wrappers with a questions array.",
  "oneOf": [
    {
      "type": "array",
      "items": { "$ref": "#/$defs/question" }
    },
    { "$ref": "#/$defs/document" }
  ],
  "$defs": {
    "document": {
      "type": "object",
      "additionalProperties": true,
      "required": ["questions"],
      "properties": {
        "topic":        { "type": "string", "minLength": 2 },
        "topicSlug":    { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "domain":       { "type": "string", "minLength": 2 },
        "module":       { "type": "string", "minLength": 2 },
        "last_updated": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "questions": {
          "type": "array",
          "minItems": 0,
          "items": { "$ref": "#/$defs/question" }
        }
      }
    },
    "question": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "id", "slug", "question",
        "direct_answer",
        "answer", "seo"
      ],
      "properties": {
        "id":            { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "slug": {
          "type": "string",
          "anyOf": [
            { "pattern": "^[a-z0-9][a-z0-9-]*$" },
            {
              "const": "iterate-map-java-entrySet",
              "deprecated": true,
              "description": "Grandfathered public route; changing its case would break an existing URL."
            }
          ]
        },
        "question":      { "type": "string", "minLength": 5 },
        "title":         { "type": "string", "minLength": 5, "maxLength": 220 },
        "direct_answer": { "type": "string", "minLength": 40 },
        "layout_type":   { "type": "string" },
        "difficulty":    { "enum": ["beginner", "easy", "medium", "hard", "intermediate", "advanced"] },
        "importance":    { "enum": ["low", "medium", "high", "critical"] },
        "reading_time_minutes": { "type": "integer", "minimum": 1 },
        "last_updated":  { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "interviewer_intent": { "$ref": "#/$defs/interviewer_intent" },
        "company_tags":  { "type": "array", "items": { "type": "string" } },
        "answer":        { "$ref": "#/$defs/answer" },
        "followup_questions": {
          "$ref": "#/$defs/followup_questions"
        },
        "follow_up_questions": { "$ref": "#/$defs/followup_questions" },
        "seo":           { "$ref": "#/$defs/seo" },
        "order":         { "type": "integer" }
      }
    },
    "followup_questions": {
      "oneOf": [
        {
          "type": "array",
          "minItems": 0,
          "items": { "type": "string", "minLength": 5 }
        },
        { "type": "null" }
      ]
    },
    "interviewer_intent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["testing"],
      "properties": {
        "testing":        { "type": "string", "minLength": 10 },
        "common_mistake": { "type": "string" },
        "to_stand_out":   { "type": "string" }
      }
    },
    "answer": {
      "type": "object",
      "additionalProperties": true,
      "required": ["sections"],
      "properties": {
        "sections": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/section" },
          "allOf": [
            {
              "description": "Zone 1: quick revision",
              "contains": {
                "type": "object",
                "required": ["type"],
                "properties": {
                  "type": { "enum": ["key_points", "important_points"] }
                }
              },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "description": "Zone 2: interview answer",
              "contains": {
                "type": "object",
                "required": ["type"],
                "properties": {
                  "type": { "const": "speakable_answer" }
                }
              },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "description": "Zone 3: at least one deep-dive section",
              "contains": {
                "type": "object",
                "required": ["type"],
                "properties": {
                  "type": {
                    "not": {
                      "enum": [
                        "key_points", "important_points",
                        "speakable_answer", "interviewer_expectation"
                      ]
                    }
                  }
                }
              },
              "minContains": 1
            }
          ]
        }
      }
    },
    "section": {
      "type": "object",
      "additionalProperties": true,
      "required": ["type"],
      "anyOf": [
        {
          "required": ["content"],
          "properties": {
            "content": {
              "oneOf": [
                { "type": "string", "pattern": "\\S" },
                { "type": "array", "minItems": 1 },
                { "type": "object", "minProperties": 1 }
              ]
            }
          }
        },
        {
          "required": ["items"],
          "properties": { "items": { "type": "array", "minItems": 1 } }
        },
        {
          "required": ["beats"],
          "properties": { "beats": { "type": "array", "minItems": 1 } }
        },
        {
          "required": ["summary"],
          "properties": { "summary": { "type": "string", "pattern": "\\S" } }
        },
        {
          "required": ["mistakes"],
          "properties": { "mistakes": { "type": "array", "minItems": 1 } }
        },
        {
          "required": ["questions"],
          "properties": { "questions": { "type": "array", "minItems": 1 } }
        },
        {
          "required": ["columns", "rows"],
          "properties": {
            "columns": { "type": "array", "minItems": 1 },
            "rows": { "type": "array", "minItems": 1 }
          }
        }
      ],
      "properties": {
        "type": {
          "enum": [
            "overview", "comparison_table", "step",
            "before_code", "after_code", "phase",
            "mermaid", "tradeoffs", "key_points",
            "speakable_answer", "code", "interviewer_expectation",
            "deep_explanation", "architecture_diagram", "code_example",
            "when_to_use", "component", "concept_map",
            "problem_statement", "reference_group", "diagnosis",
            "important_points", "warning", "explanation",
            "recipe", "practice_prompt", "common_mistakes",
            "tip", "requirements", "approach", "design_diagram",
            "followup_questions", "sample_data", "query_example",
            "diagram", "flow_diagram", "sequence_diagram", "decision_tree",
            "core_concepts", "short_summary", "detailed_explanation",
            "best_practices", "real_world_example", "scenario_based",
            "tradeoff", "table", "visual", "practice", "exercise",
            "trace", "comparison", "timeline", "flow", "state"
          ]
        },
        "title":   { "type": "string" },
        "content": {},
        "items": { "type": "array" },
        "summary": { "type": "string" },
        "mistakes": { "type": "array" },
        "questions": { "type": "array" },
        "columns": { "type": "array" },
        "rows": { "type": "array" },
        "answerSize": { "enum": ["compact", "standard", "deep"] },
        "beats": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["cue", "spokenText"],
            "properties": {
              "cue": { "type": "string", "minLength": 2 },
              "stage": { "type": "string", "minLength": 2 },
              "leadIn": { "type": "string", "minLength": 2 },
              "spokenText": { "type": "string", "pattern": "\\S" },
              "recallRule": { "type": "string", "minLength": 2 },
              "support": {
                "type": "object",
                "additionalProperties": false,
                "required": ["type"],
                "properties": {
                  "type": { "enum": ["code", "trace", "checklist", "comparison"] },
                  "title": { "type": "string" },
                  "code": { "type": "string" },
                  "language": { "type": "string" },
                  "caption": { "type": "string" },
                  "items": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["label"],
                      "properties": {
                        "label": { "type": "string" },
                        "value": { "type": "string" },
                        "detail": { "type": "string" },
                        "tone": { "enum": ["neutral", "blue", "green", "orange"] }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "seo": {
      "type": "object",
      "additionalProperties": true,
      "anyOf": [
        { "required": ["metaTitle", "metaDescription"] },
        { "required": ["title", "description"] }
      ],
      "properties": {
        "metaTitle":       { "type": "string", "minLength": 10 },
        "metaDescription": { "type": "string", "minLength": 40 },
        "title":           { "type": "string", "minLength": 10 },
        "description":     { "type": "string", "minLength": 40 },
        "keywords": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
