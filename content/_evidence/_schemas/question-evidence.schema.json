{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://interviewexplainer.dev/schemas/question-evidence.schema.json",
  "title": "InterviewExplainer per-question evidence record",
  "description": "Internal provenance for one canonical learning question. This metadata is not a fourth learner-facing section.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "domainSlug",
    "moduleSlug",
    "topicSlug",
    "questionSlug",
    "questionText",
    "target",
    "versionProfiles",
    "styleSourceRefs",
    "claims",
    "examples",
    "visuals",
    "review"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": "1.0"
    },
    "domainSlug": {
      "$ref": "#/$defs/slug"
    },
    "moduleSlug": {
      "$ref": "#/$defs/slug"
    },
    "topicSlug": {
      "$ref": "#/$defs/slug"
    },
    "questionSlug": {
      "$ref": "#/$defs/slug"
    },
    "questionText": {
      "type": "string",
      "minLength": 5
    },
    "contentHash": {
      "description": "Hash of the reviewed learner-facing title, question, direct answer, and three-zone answer. Required by the audit at fact_checked or later.",
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "target": {
      "$ref": "#/$defs/target"
    },
    "versionProfiles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/id"
      }
    },
    "styleSourceRefs": {
      "description": "Familiar tutorial sources used only for wording, sequencing, and expected interview breadth. They cannot substantiate claims.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/id"
      }
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/claim"
      }
    },
    "examples": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/example"
      }
    },
    "visuals": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/visual"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 3
      }
    },
    "review": {
      "$ref": "#/$defs/review"
    }
  },
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]*$"
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["questionType", "learningOutcome", "inScope", "outOfScope", "prerequisites"],
      "properties": {
        "questionType": {
          "enum": [
            "definition",
            "comparison",
            "api_or_syntax",
            "mechanism_or_lifecycle",
            "implementation",
            "debugging_scenario",
            "when_to_use_or_design",
            "security",
            "performance",
            "testing",
            "dsa",
            "behavioral"
          ]
        },
        "learningOutcome": {
          "type": "string",
          "minLength": 20
        },
        "inScope": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 3
          }
        },
        "outOfScope": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 3
          }
        },
        "prerequisites": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 3
          }
        }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "classification",
        "statement",
        "sectionTargets",
        "sourceRefs",
        "versionDependent"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "enum": [
            "definition",
            "mechanism",
            "behavior",
            "boundary",
            "comparison",
            "version",
            "performance",
            "security",
            "guidance"
          ]
        },
        "classification": {
          "enum": [
            "normative",
            "documented_behavior",
            "implementation_detail",
            "canonical_guidance",
            "example_derived"
          ]
        },
        "statement": {
          "type": "string",
          "minLength": 20
        },
        "sectionTargets": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["quick_revision", "interview_answer", "deep_dive"]
          }
        },
        "sourceRefs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "versionDependent": {
          "type": "boolean"
        },
        "versionProfiles": {
          "description": "Exact version-policy profiles that govern this claim. Required by the audit when versionDependent is true.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "notes": {
          "type": "string",
          "minLength": 3
        }
      }
    },
    "example": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "title", "sectionTarget", "claimRefs", "validation"],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "enum": [
            "java",
            "sql",
            "http",
            "json",
            "xml",
            "shell",
            "git",
            "configuration",
            "manual_scenario"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 3
        },
        "sectionTarget": {
          "enum": ["quick_revision", "interview_answer", "deep_dive"]
        },
        "claimRefs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "validation": {
          "$ref": "#/$defs/validation"
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "status"],
      "properties": {
        "method": {
          "enum": [
            "compile_run",
            "compile_only",
            "unit_test",
            "integration_test",
            "parse",
            "command_trace",
            "manual_review",
            "not_applicable"
          ]
        },
        "status": {
          "enum": ["planned", "passed", "failed", "manual_review"]
        },
        "command": {
          "type": "string",
          "minLength": 2
        },
        "expected": {
          "type": "string",
          "minLength": 2
        },
        "checkedAt": {
          "type": "string",
          "format": "date"
        },
        "checkedBy": {
          "type": "string",
          "minLength": 2
        }
      }
    },
    "visual": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "title", "claimRefs", "reviewStatus"],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "enum": [
            "flow",
            "sequence",
            "state",
            "comparison",
            "hierarchy",
            "decision",
            "architecture",
            "trace"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 3
        },
        "claimRefs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "reviewStatus": {
          "enum": ["planned", "verified", "rejected"]
        },
        "reviewedAt": {
          "type": "string",
          "format": "date"
        },
        "reviewedBy": {
          "type": "string",
          "minLength": 2
        }
      }
    },
    "checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["by", "at"],
      "properties": {
        "by": {
          "type": "string",
          "minLength": 2
        },
        "at": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {
          "enum": ["draft", "fact_checked", "example_verified", "editorial_checked", "approved"]
        },
        "factChecked": {
          "$ref": "#/$defs/checkpoint"
        },
        "exampleVerified": {
          "$ref": "#/$defs/checkpoint"
        },
        "editorialChecked": {
          "$ref": "#/$defs/checkpoint"
        },
        "notes": {
          "type": "string",
          "minLength": 3
        }
      }
    }
  }
}
