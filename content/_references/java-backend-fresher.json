{
  "schemaVersion": "1.0",
  "domainSlug": "java-backend-fresher",
  "purpose": "Reusable provenance registry for Java Backend Fresher learning content. Technical claims use truth-capable sources; tutorial sites are retained only to calibrate familiar language, question wording, and teaching order.",
  "lastReviewed": "2026-09-09",
  "authorityHierarchy": [
    {
      "authority": "normative",
      "rank": 1,
      "claimUse": "allowed",
      "description": "Specifications, standards, and language or protocol contracts."
    },
    {
      "authority": "official",
      "rank": 2,
      "claimUse": "allowed",
      "description": "Official API, product, implementation, and release documentation."
    },
    {
      "authority": "canonical",
      "rank": 3,
      "claimUse": "allowed",
      "description": "Widely accepted books or maintainer material for areas without a complete normative specification."
    },
    {
      "authority": "explanatory",
      "rank": 4,
      "claimUse": "supporting_only",
      "description": "High-quality explanatory material that can clarify, but cannot override primary evidence."
    },
    {
      "authority": "style_only",
      "rank": 5,
      "claimUse": "forbidden",
      "description": "Familiar interview and tutorial sites used only for vocabulary, sequencing, and question-discovery."
    }
  ],
  "conflictPolicy": [
    "Prefer the source with the highest authority and the narrowest matching version and scope.",
    "A normative contract overrides a tutorial explanation; an exact product-version document overrides a generic product article.",
    "OpenJDK source may prove an implementation detail only when the answer labels it as an implementation detail and names the relevant JDK line.",
    "When sources describe different scopes, narrow the claim instead of blending them into a false universal rule.",
    "Tutorial wording must be independently rewritten; source prose is never copied into learner content."
  ],
  "minimumReferenceSets": {
    "simple_concept": "At least one normative or official source, one style-only reference, and one traceable example.",
    "api_or_comparison": "Official documentation for every compared API or option, one style-only reference, and a compiled or executed example.",
    "internals_or_versioned": "A specification or official contract, an exact implementation or release source, an explicit version profile, and an observable trace.",
    "security_concurrency_or_data_loss": "At least two independent primary authorities plus executable, test, or protocol evidence.",
    "design_or_behavioral": "At least one canonical source and one independent guidance source; recommendations must be labelled as guidance rather than universal facts."
  },
