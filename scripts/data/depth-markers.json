{
  "$comment": "Per-archetype depth-marker rules. Mirrors docs/speakable/depth-markers.md verbatim. The lint script (scripts/audit_speakable.py) reads this file as its source of truth for §7.6 depth rules. Each archetype defines (1) the rule severity (mandatory|recommended|capacity_numbers), (2) the beats where the marker may live, and (3) inline signal phrases the lint searches for. Phase 0 codex did not yet expose `depth_markers.X.signals` keys; the signal phrases below are sourced verbatim from the worked-examples block of depth-markers.md (and SPEAKABLE-PLAN.md §9). They are intentionally generic so any topic in their family triggers the marker — refine in a future codex pass.",
  "version": 1,
  "source": "docs/speakable/depth-markers.md",
  "A": {
    "rule": "mandatory",
    "severity": "fail",
    "valid_beats": ["parts_or_states", "pitfalls", "example", "how_to_use"],
    "signal_phrases": [
      "lifecycle",
      "states",
      "collisions",
      "bucket",
      "chaining",
      "IS-A",
      "HAS-A",
      "boundary",
      "non-obvious",
      "sharper",
      "implies",
      "hidden",
      "sharp edge"
    ]
  },
  "B": {
    "rule": "mandatory",
    "severity": "fail",
    "valid_beats": ["differences", "when_to_pick", "tiny_example"],
    "signal_phrases": [
      "cache locality",
      "prefetcher",
      "String pool",
      "intern",
      "N+1",
      "gotcha",
      "candidates miss",
      "doesn't show up",
      "trap"
    ]
  },
  "C": {
    "rule": "mandatory",
    "severity": "fail",
    "required_beat": "failure_mode",
    "valid_beats": ["failure_mode"],
    "signal_phrases": [
      "resize storm",
      "rebalance",
      "deadlock",
      "N+1",
      "infinite loop",
      "starvation",
      "thrash",
      "circuit",
      "cascading",
      "pause-time",
      "under load",
      "production"
    ]
  },
  "D": {
    "rule": "mandatory",
    "severity": "fail",
    "required_beat": "tools",
    "valid_beats": ["tools", "step_by_step"],
    "min_tool_count": 2,
    "signal_phrases": [
      "jstack",
      "async-profiler",
      "Micrometer",
      "EXPLAIN",
      "EXPLAIN ANALYZE",
      "pg_stat_statements",
      "kubectl",
      "kubectl describe",
      "kubectl logs",
      "histogram",
      "GC log",
      "flame graph",
      "thread dump",
      "heap dump",
      "metrics",
      "dashboard",
      "trace",
      "tracing"
    ]
  },
  "E": {
    "rule": "mandatory",
    "severity": "fail",
    "required_beat": "rethink_if",
    "valid_beats": ["rethink_if"],
    "must_contain_threshold": true,
    "trigger_words": ["if", "when", "unless", "once", "the moment"]
  },
  "F": {
    "rule": "capacity_numbers",
    "severity": "fail",
    "required_in_beats": ["capacity", "bottleneck_deep_dive"],
    "must_contain_numeric_capacity": true,
    "numeric_units": [
      "req/s",
      "rps",
      "writes/sec",
      "reads/sec",
      "qps",
      "GB",
      "MB",
      "TB",
      "KB",
      "ms",
      "s",
      "p50",
      "p95",
      "p99",
      "p99.9",
      "DAU",
      "MAU",
      "%"
    ]
  },
  "G": {
    "rule": "recommended",
    "severity": "warn",
    "required_beat": "reflection",
    "valid_beats": ["reflection"],
    "signal_phrases": [
      "looking back",
      "in hindsight",
      "I'd have",
      "I would",
      "differently",
      "what I learned",
      "next time",
      "the lesson"
    ]
  }
