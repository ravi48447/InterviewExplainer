{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://interviewexplainer.local/schemas/speakable_v2.json",
  "title": "Speakable v2",
  "description": "Structured Speakable v2. Mirrors frontend/lib/speakable/schema.ts (kept in lockstep). Consumed by scripts/audit_speakable.py (Phase 1). Plan reference: SPEAKABLE-PLAN.md §5 + §10.3.",

  "$defs": {

    "Pillar": {
      "type": "string",
      "enum": ["P01", "P02", "P03", "P04", "P05", "P06", "P07", "P08", "P09", "P10", "P11", "P12"]
    },

    "AudienceAssumption": {
      "type": "string",
      "enum": ["beginner", "familiar", "advanced"]
    },

    "Voice": {
      "type": "string",
      "enum": ["friendly", "neutral", "technical"]
    },

    "SpeakableStatus": {
      "type": "string",
      "enum": [
        "legacy",
        "pending_review",
        "approved",
        "rolled_back",
        "priority_handcraft",
        "pending_handcraft",
        "pending_handcraft_blocked_by_smoke"
      ]
    },

    "BeatGroup": {
      "type": "object",
      "properties": {
        "heading": { "type": "string", "minLength": 1 },
        "text":    { "type": "string", "minLength": 1 }
      },
      "required": ["heading", "text"],
      "additionalProperties": false
    },

    "BeatTableRow": {
      "type": "object",
      "properties": {
        "axis":   { "type": "string", "minLength": 1 },
        "values": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        }
      },
      "required": ["axis", "values"],
      "additionalProperties": false
    },

    "PayloadParagraph": {
      "type": "object",
      "properties": {
        "layout": { "const": "paragraph" },
        "text":   { "type": "string", "minLength": 1 },
        "label":  { "type": "string" }
      },
      "required": ["layout", "text"]
    },

    "PayloadParagraphs": {
      "type": "object",
      "properties": {
        "layout":     { "const": "paragraphs" },
        "paragraphs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 2
        },
        "label":      { "type": "string" }
      },
      "required": ["layout", "paragraphs"]
    },

    "PayloadGroupedParagraphs": {
      "type": "object",
      "properties": {
        "layout": { "const": "grouped_paragraphs" },
        "groups": {
          "type": "array",
          "items": { "$ref": "#/$defs/BeatGroup" },
          "minItems": 2
        },
        "label":  { "type": "string" }
      },
      "required": ["layout", "groups"]
    },

    "PayloadBullets": {
      "type": "object",
      "properties": {
        "layout": { "const": "bullets" },
        "items": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 2
        },
        "label":  { "type": "string" }
      },
      "required": ["layout", "items"]
    },

    "PayloadOrderedList": {
      "type": "object",
      "properties": {
        "layout": { "const": "ordered_list" },
        "steps": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 2
        },
        "label":  { "type": "string" }
      },
      "required": ["layout", "steps"]
    },

    "PayloadMiniTable": {
      "type": "object",
      "properties": {
        "layout":  { "const": "mini_table" },
        "columns": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 2,
          "maxItems": 3
        },
        "rows": {
          "type": "array",
          "items": { "$ref": "#/$defs/BeatTableRow" },
          "minItems": 2
        },
        "label":   { "type": "string" }
      },
      "required": ["layout", "columns", "rows"]
    },

    "PayloadCallout": {
      "type": "object",
      "properties": {
        "layout": { "const": "callout" },
        "text":   { "type": "string", "minLength": 1 },
        "label":  { "type": "string" }
      },
      "required": ["layout", "text"]
    },

    "BeatLayoutOneOf": {
      "oneOf": [
        { "$ref": "#/$defs/PayloadParagraph" },
        { "$ref": "#/$defs/PayloadParagraphs" },
        { "$ref": "#/$defs/PayloadGroupedParagraphs" },
        { "$ref": "#/$defs/PayloadBullets" },
        { "$ref": "#/$defs/PayloadOrderedList" },
        { "$ref": "#/$defs/PayloadMiniTable" },
        { "$ref": "#/$defs/PayloadCallout" }
      ]
    },

    "ArchetypeABeatKind": {
      "type": "string",
      "enum": ["definition", "why_exists", "parts_or_states", "how_to_use", "example", "pitfalls"]
    },
    "ArchetypeBBeatKind": {
      "type": "string",
      "enum": ["what_each_is", "differences", "when_to_pick", "tiny_example"]
    },
    "ArchetypeCBeatKind": {
      "type": "string",
      "enum": ["mental_model", "mechanism", "edge_cases", "failure_mode", "example"]
    },
    "ArchetypeDBeatKind": {
      "type": "string",
      "enum": ["clarify", "hypothesis", "step_by_step", "tools", "tradeoff"]
    },
    "ArchetypeEBeatKind": {
      "type": "string",
      "enum": ["optimising_for", "options", "tradeoffs", "decision", "rethink_if"]
    },
    "ArchetypeFBeatKind": {
      "type": "string",
      "enum": ["requirements_fr_nfr", "capacity", "api", "data_model", "high_level", "bottleneck_deep_dive", "tradeoffs"]
    },
    "ArchetypeGBeatKind": {
      "type": "string",
      "enum": ["situation", "task", "action", "result", "reflection"]
    },

    "ArchetypeABeat": {
      "allOf": [
        { "$ref": "#/$defs/BeatLayoutOneOf" },
        {
          "type": "object",
          "properties": { "kind": { "$ref": "#/$defs/ArchetypeABeatKind" } },
          "required": ["kind"]
        }
      ]
    },
    "ArchetypeBBeat": {
      "allOf": [
        { "$ref": "#/$defs/BeatLayoutOneOf" },
        {
          "type": "object",
          "properties": { "kind": { "$ref": "#/$defs/ArchetypeBBeatKind" } },
          "required": ["kind"]
        }
      ]
    },
    "ArchetypeCBeat": {
      "allOf": [
        { "$ref": "#/$defs/BeatLayoutOneOf" },
        {
          "type": "object",
          "properties": { "kind": { "$ref": "#/$defs/ArchetypeCBeatKind" } },
          "required": ["kind"]
        }
      ]
    },
    "ArchetypeDBeat": {
      "allOf": [
        { "$ref": "#/$defs/BeatLayoutOneOf" },
        {
          "type": "object",
          "properties": { "kind": { "$ref": "#/$defs/ArchetypeDBeatKind" } },
          "required": ["kind"]
        }
      ]
    },
    "ArchetypeEBeat": {
      "allOf": [
        { "$ref": "#/$defs/BeatLayoutOneOf" },
        {
          "type": "object",
          "properties": { "kind": { "$ref": "#/$defs/ArchetypeEBeatKind" } },
          "required": ["kind"]
        }
      ]
    },
    "ArchetypeFBeat": {
      "allOf": [
        { "$ref": "#/$defs/BeatLayoutOneOf" },
        {
          "type": "object",
          "properties": { "kind": { "$ref": "#/$defs/ArchetypeFBeatKind" } },
          "required": ["kind"]
        }
      ]
    },
    "ArchetypeGBeat": {
      "allOf": [
        { "$ref": "#/$defs/BeatLayoutOneOf" },
        {
          "type": "object",
          "properties": { "kind": { "$ref": "#/$defs/ArchetypeGBeatKind" } },
          "required": ["kind"]
        }
      ]
    },

    "Common": {
      "type": "object",
      "properties": {
        "pillar":               { "$ref": "#/$defs/Pillar" },
        "audience_assumption":  { "$ref": "#/$defs/AudienceAssumption" },
        "voice":                { "$ref": "#/$defs/Voice" },
        "familiarity_anchors":  {
          "type": "array",
          "items": { "type": "string" }
        },
        "standard_example":     { "type": "string" },
        "hook":                 { "type": "string", "minLength": 1 },
        "cap":                  { "type": "string", "minLength": 1 },
        "followup_handoff":     {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 2
        },
        "tts_overrides": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "speakable_status":           { "$ref": "#/$defs/SpeakableStatus" },
        "familiarity_override":       { "type": "boolean" },
        "familiarity_override_reason":{ "type": "string" }
      },
      "required": [
        "pillar",
        "audience_assumption",
        "voice",
        "familiarity_anchors",
        "standard_example",
        "hook",
        "cap",
        "followup_handoff",
        "speakable_status"
      ],
      "dependentRequired": {
        "familiarity_override": ["familiarity_override_reason"]
      }
    },

    "SpeakableA": {
      "allOf": [
        { "$ref": "#/$defs/Common" },
        {
          "type": "object",
          "properties": {
            "archetype": { "const": "A" },
            "beats": {
              "type": "array",
              "items": { "$ref": "#/$defs/ArchetypeABeat" },
              "minItems": 1
            }
          },
          "required": ["archetype", "beats"]
        }
      ]
    },
    "SpeakableB": {
      "allOf": [
        { "$ref": "#/$defs/Common" },
        {
          "type": "object",
          "properties": {
            "archetype": { "const": "B" },
            "beats": {
              "type": "array",
              "items": { "$ref": "#/$defs/ArchetypeBBeat" },
              "minItems": 1
            }
          },
          "required": ["archetype", "beats"]
        }
      ]
    },
    "SpeakableC": {
      "allOf": [
        { "$ref": "#/$defs/Common" },
        {
          "type": "object",
          "properties": {
            "archetype": { "const": "C" },
            "beats": {
              "type": "array",
              "items": { "$ref": "#/$defs/ArchetypeCBeat" },
              "minItems": 1
            }
          },
          "required": ["archetype", "beats"]
        }
      ]
    },
    "SpeakableD": {
      "allOf": [
        { "$ref": "#/$defs/Common" },
        {
          "type": "object",
          "properties": {
            "archetype": { "const": "D" },
            "beats": {
              "type": "array",
              "items": { "$ref": "#/$defs/ArchetypeDBeat" },
              "minItems": 1
            }
          },
          "required": ["archetype", "beats"]
        }
      ]
    },
    "SpeakableE": {
      "allOf": [
        { "$ref": "#/$defs/Common" },
        {
          "type": "object",
          "properties": {
            "archetype": { "const": "E" },
            "beats": {
              "type": "array",
              "items": { "$ref": "#/$defs/ArchetypeEBeat" },
              "minItems": 1
            }
          },
          "required": ["archetype", "beats"]
        }
      ]
    },
    "SpeakableF": {
      "allOf": [
        { "$ref": "#/$defs/Common" },
        {
          "type": "object",
          "properties": {
            "archetype": { "const": "F" },
            "beats": {
              "type": "array",
              "items": { "$ref": "#/$defs/ArchetypeFBeat" },
              "minItems": 1
            }
          },
          "required": ["archetype", "beats"]
        }
      ]
    },
    "SpeakableG": {
      "allOf": [
        { "$ref": "#/$defs/Common" },
        {
          "type": "object",
          "properties": {
            "archetype": { "const": "G" },
            "beats": {
              "type": "array",
              "items": { "$ref": "#/$defs/ArchetypeGBeat" },
              "minItems": 1
            }
          },
          "required": ["archetype", "beats"]
        }
      ]
    }
  },

  "oneOf": [
    { "$ref": "#/$defs/SpeakableA" },
    { "$ref": "#/$defs/SpeakableB" },
    { "$ref": "#/$defs/SpeakableC" },
    { "$ref": "#/$defs/SpeakableD" },
    { "$ref": "#/$defs/SpeakableE" },
    { "$ref": "#/$defs/SpeakableF" },
    { "$ref": "#/$defs/SpeakableG" }
  ]
}
