# ============================================================
# application.properties.example
# Copy this file to application.properties and fill in your values.
# DO NOT commit application.properties — it contains real secrets.
# ============================================================

spring.application.name=interviewexplainer-backend

# ── Database ──────────────────────────────────────────────
spring.datasource.url=jdbc:postgresql://localhost:5432/interviewexplainer
spring.datasource.username=YOUR_DB_USERNAME
spring.datasource.password=YOUR_DB_PASSWORD
spring.datasource.driver-class-name=org.postgresql.Driver

# ── JPA / Hibernate ───────────────────────────────────────
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=false
spring.jpa.properties.hibernate.format_sql=true
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.PostgreSQLDialect

# ── SQL Init ──────────────────────────────────────────────
spring.sql.init.mode=always
spring.sql.init.continue-on-error=true

# ── Server ────────────────────────────────────────────────
server.port=8080
spring.mvc.pathmatch.matching-strategy=ant_path_matcher

# ── Actuator ──────────────────────────────────────────────
management.endpoints.web.exposure.include=health,info
