# ─── Content generation ──────────────────────────────────────────────────────
# Claude API Key (required for batchQuestionGenerator.ts)
# Get your API key from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your_api_key_here


# ─── Frontend (frontend/.env.local) ──────────────────────────────────────────
# The variables below configure the Next.js auth system. Everything works
# locally WITHOUT setting any of them — magic-link / reset emails are printed to
# the server console, and social-login buttons stay hidden until configured.

# Secret used to sign session tokens (HMAC). Set a long random string in prod.
AUTH_SECRET=change-me-to-a-long-random-secret

# Public base URL of the site (used to build email + OAuth callback links).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Transactional email via Resend (https://resend.com). If unset, emails are
# logged to the server console instead of being sent.
RESEND_API_KEY=
RESEND_FROM_EMAIL=InterviewExplainer <onboarding@resend.dev>

# Google OAuth — create credentials at https://console.cloud.google.com
#   Authorized redirect URI: <SITE_URL>/api/auth/oauth/google/callback
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth — create an app at https://github.com/settings/developers
#   Authorization callback URL: <SITE_URL>/api/auth/oauth/github/callback
NEXT_PUBLIC_GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Billing — keep payments OFF during beta (Pro unlocks free). Set to "true"
# only once Razorpay keys are configured.
NEXT_PUBLIC_PAYMENTS_ENABLED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
