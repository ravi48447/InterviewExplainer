{
  "version": 1,
  "hooks": {
    "sessionStart": [
      { "command": ".cursor/hooks/heartbeat.sh", "timeout": 5 }
    ],
    "postToolUse": [
      { "command": ".cursor/hooks/heartbeat.sh", "timeout": 5 }
    ],
    "afterFileEdit": [
      { "command": ".cursor/hooks/heartbeat.sh", "timeout": 5 }
    ],
    "afterAgentResponse": [
      { "command": ".cursor/hooks/heartbeat.sh", "timeout": 5 }
    ],
    "stop": [
      { "command": ".cursor/hooks/finalize_handoff.sh", "timeout": 5 }
    ]
  }
}
